DATABASE_URL=postgresql+psycopg://xymphony:xymphony@localhost:5432/xymphony
XYMPHONY_ENV=development
LOG_LEVEL=INFO

# LiveKit Cloud (media transport only — not the Xymphony runtime)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Optional runtime worker defaults
XYMPHONY_SESSION_ID=
LIVEKIT_ROOM=xymphony-dev
LIVEKIT_WORKER_IDENTITY=xymphony-worker

# LLM provider (OpenAI adapter — Phase 2 Step 2)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# STT provider (AssemblyAI adapter — Phase 2 Step 3)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ASSEMBLYAI_MODEL=universal-streaming

# TTS provider (ElevenLabs adapter — Phase 2 Step 4)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=voice_default
